/* nRF52 DK / PCA10040. START must be low; conversion uses SPI commands. */
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    ads1299_control: ads1299-control {
        compatible = "ti,ads1299-control";
        cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
        drdy-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;
    };
};

&uart0 { status = "disabled"; };
&i2c0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&spi0 { status = "disabled"; };
&spi1 { status = "disabled"; };

&pinctrl {
    spi2_ads1299_default: spi2_ads1299_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 25)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 23)>,
                    <NRF_PSEL(SPIM_MISO, 0, 24)>;
        };
    };
    spi2_ads1299_sleep: spi2_ads1299_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 25)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 23)>,
                    <NRF_PSEL(SPIM_MISO, 0, 24)>;
            low-power-enable;
        };
    };
};

&spi2 {
    compatible = "nordic,nrf-spim";
    anomaly-58-workaround;
    status = "okay";
    cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
    pinctrl-0 = <&spi2_ads1299_default>;
    pinctrl-1 = <&spi2_ads1299_sleep>;
    pinctrl-names = "default", "sleep";
    ads1299: ads1299@0 {
        compatible = "ti,ads1299";
        reg = <0>;
        spi-max-frequency = <1000000>;
    };
};
